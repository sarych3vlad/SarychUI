<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Button name="OmniCDStatusBar" frameStrata="LOW" hidden="true" virtual="true">
		<Size x="205" y="36"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture setAllPoints="true" parentKey="BG" file="Interface\AddOns\SarychUI\addons\OmniCD\Media\omnicd-texture_flat"/>
				<FontString parentKey="Text" inherits="GameFontHighlightHuge" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="3" y="0"/>
						<Anchor point="RIGHT" x="-3" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="borderTop">
					<Color r="0" g="0" b="0"/>
				</Texture>
				<Texture parentKey="borderBottom">
					<Color r="0" g="0" b="0"/>
				</Texture>
				<Texture parentKey="borderRight">
					<Color r="0" g="0" b="0"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<StatusBar parentKey="CastingBar" drawLayer="BORDER" hidden="true">
				<Size x="205" y="36"/>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="BG" setAllPoints="true" file="Interface\AddOns\SarychUI\addons\OmniCD\Media\omnicd-texture_flat"/>
					</Layer>
					<Layer level="ARTWORK">
						<FontString parentKey="Timer" inherits="GameFontHighlightHuge" justifyH="RIGHT">
							<Anchors>
								<Anchor point="RIGHT" x="-3" y="0"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Text" inherits="GameFontHighlightHuge" justifyH="LEFT"/>
					</Layer>
					<Layer level="OVERLAY">
						<Texture parentKey="Spark" file="Interface\CastingBar\UI-CastingBar-Spark" alphaMode="ADD">
							<Size x="36" y="72"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<BarTexture file="Interface\AddOns\SarychUI\addons\OmniCD\Media\omnicd-texture_flat"/>
				<BarColor r="1.0" g="1.0" b="1.0" a="1"/>
				<Scripts>
					<OnLoad>
						local parent = self:GetParent()

						self.Text:SetPoint("LEFT", self.Timer, 3, 0)
						self.Text:SetPoint("RIGHT", self.Timer, "LEFT", -3, 0)

						self:SetPoint("TOPLEFT", parent.borderTop, "BOTTOMLEFT")
						self:SetPoint("BOTTOMRIGHT", parent.borderRight, "BOTTOMLEFT")
					</OnLoad>
				</Scripts>
			</StatusBar>
		</Frames>
	</Button>
</Ui>