<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Script file="SettingsUITemplates.lua"/>

	<Frame name="AegisSettingsBackdropFrameTemplate" virtual="true">
		<Scripts>
			<OnLoad>
				self.OnBackdropSizeChanged = self.OnBackdropSizeChanged or function() end;
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame name="AegisSettingsInterfacePanelTemplate" virtual="true" hidden="true">
		<Frames>
			<ScrollFrame parentKey="Scroll" name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-8"/>
					<Anchor point="BOTTOMRIGHT" x="-26" y="8"/>
				</Anchors>
				<ScrollChild>
					<Frame parentKey="Content">
						<Size x="560" y="1"/>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
	</Frame>

	<Frame name="AegisSettingsRuntimePanelTemplate" virtual="true" hidden="true" enableMouse="true" movable="true" frameStrata="DIALOG">
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Title" inherits="GameFontNormalLarge">
					<Anchors>
						<Anchor point="TOPLEFT" x="16" y="-12"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-4" y="-4"/>
				</Anchors>
			</Button>
			<ScrollFrame parentKey="Scroll" name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="12" y="-42"/>
					<Anchor point="BOTTOMRIGHT" x="-30" y="12"/>
				</Anchors>
				<ScrollChild>
					<Frame parentKey="Content">
						<Size x="470" y="1"/>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
	</Frame>

	<Frame name="AegisSettingsSectionTemplate" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="TitleText" inherits="GameFontNormalLarge" nonspacewrap="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="12" y="-10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="AegisSettingsDescriptionTemplate" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon"/>
				<FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" nonspacewrap="true">
					<Color r="0.7" g="0.7" b="0.7"/>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="AegisSettingsSliderTemplate" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontHighlight" justifyH="LEFT"/>
				<FontString parentKey="ValueText" inherits="GameFontHighlightSmall" justifyH="LEFT"/>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="Back">
				<NormalTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Up"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Highlight" alphaMode="ADD"/>
				<PushedTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Down"/>
			</Button>
			<Button parentKey="Forward">
				<NormalTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Up"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Highlight" alphaMode="ADD"/>
				<PushedTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Down"/>
			</Button>
		</Frames>
	</Frame>

	<Button name="AegisSettingsButtonTemplate" inherits="UIPanelButtonTemplate" virtual="true">
		<NormalTexture file="Interface\Buttons\UI-DialogBox-Button-Up">
			<TexCoords left="0" right="1" top="0" bottom="0.71875"/>
		</NormalTexture>
		<HighlightTexture file="Interface\Buttons\UI-DialogBox-Button-Highlight" alphaMode="ADD">
			<TexCoords left="0" right="1" top="0" bottom="0.71875"/>
		</HighlightTexture>
		<PushedTexture file="Interface\Buttons\UI-DialogBox-Button-Down">
			<TexCoords left="0" right="1" top="0" bottom="0.71875"/>
		</PushedTexture>
	</Button>

	<Frame name="AegisSettingsDropdownMenuTemplate" virtual="true" hidden="true" enableMouse="true">
	</Frame>

	<Frame name="AegisSettingsDropdownTemplate" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontHighlight" justifyH="LEFT"/>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="Dropdown">
				<Frames>
					<Frame parentKey="Border" setAllPoints="true"/>
				</Frames>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="SelectedText" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="MIDDLE">
							<Size x="0" y="64"/>
							<Anchors>
								<Anchor point="LEFT" x="6" y="0"/>
								<Anchor point="RIGHT" x="-20" y="0"/>
							</Anchors>
						</FontString>
						<Texture parentKey="Arrow" file="Interface\Buttons\Arrow-Down-Down">
							<Size x="12" y="18"/>
							<Anchors>
								<Anchor point="RIGHT" x="-8" y="-4"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</Button>
		</Frames>
	</Frame>

	<Button name="AegisSettingsDropdownLineTemplate" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="8" y="0"/>
						<Anchor point="RIGHT" x="-8" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Highlight" file="Interface\Buttons\WHITE8x8">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="0.2"/>
				</Texture>
			</Layer>
		</Layers>
	</Button>
</Ui>
