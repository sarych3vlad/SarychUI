<Ui xmlns="http://www.blizzard.com/wow/ui/"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

  <Texture name="SarychUICUF_UIPanelButtonHighlightTexture" file="Interface\AddOns\SarychUI\media\components\modules\group_frames\engine\CompactRaidFrame\Media\Buttons\UI-Panel-Button-Highlight" alphaMode="ADD" virtual="true">
    <TexCoords left="0" right="0.625" top="0" bottom="0.6875" />
  </Texture>

  <Button name="SarychUICUF_UIPanelButtonNoTooltipTemplate" virtual="true">
    <Size x="40" y="22" />
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Left" file="Interface\AddOns\SarychUI\media\components\modules\group_frames\engine\CompactRaidFrame\Media\Buttons\UI-Panel-Button-Up">
          <Size x="12" y="22" />
          <Anchors>
            <Anchor point="TOPLEFT" />
            <Anchor point="BOTTOMLEFT" />
          </Anchors>
          <TexCoords left="0" right="0.09375" top="0" bottom="0.6875" />
        </Texture>
        <Texture parentKey="Right" file="Interface\AddOns\SarychUI\media\components\modules\group_frames\engine\CompactRaidFrame\Media\Buttons\UI-Panel-Button-Up">
          <Size x="12" y="22" />
          <Anchors>
            <Anchor point="TOPRIGHT" />
            <Anchor point="BOTTOMRIGHT" />
          </Anchors>
          <TexCoords left="0.53125" right="0.625" top="0" bottom="0.6875" />
        </Texture>
        <Texture parentKey="Middle" file="Interface\AddOns\SarychUI\media\components\modules\group_frames\engine\CompactRaidFrame\Media\Buttons\UI-Panel-Button-Up">
          <Size x="12" y="22" />
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" />
            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT" />
          </Anchors>
          <TexCoords left="0.09375" right="0.53125" top="0" bottom="0.6875" />
        </Texture>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>SarychUI.Compat.PanelButtonOnLoad(self)</OnLoad>
      <OnMouseDown>SarychUI.Compat.PanelButtonSetState(self, true)</OnMouseDown>
      <OnMouseUp>SarychUI.Compat.PanelButtonSetState(self, false)</OnMouseUp>
      <OnShow>SarychUI.Compat.PanelButtonSetState(self, false)</OnShow>
      <OnDisable>SarychUI.Compat.PanelButtonSetState(self, false)</OnDisable>
      <OnEnable>SarychUI.Compat.PanelButtonSetState(self, false)</OnEnable>
    </Scripts>
    <ButtonText name="$parentText" parentKey="Text" />
    <NormalFont style="GameFontNormal" />
    <HighlightFont style="GameFontHighlight" />
    <DisabledFont style="GameFontDisable" />
    <HighlightTexture inherits="SarychUICUF_UIPanelButtonHighlightTexture" />
  </Button>

</Ui>